{
  "uid": "lts-baseline",
  "title": "Phase 01 - Baseline",
  "tags": ["loadtest-sim", "phase-01"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "요청 처리",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "RPS (앱 기준, 상태코드별)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_request_duration_seconds_count{route=\"/api/v1/events/:eventId/reservations\"}[15s]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "지연 p50 / p95 / p99 (앱 히스토그램) — SLO 200ms",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 0 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/api/v1/events/:eventId/reservations\"}[15s])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/api/v1/events/:eventId/reservations\"}[15s])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/api/v1/events/:eventId/reservations\"}[15s])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "in-flight 요청 수 (앱이 동시에 물고 있는 요청)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "http_requests_in_flight", "legendFormat": "in-flight" }
      ]
    },
    {
      "type": "timeseries",
      "title": "k6 도착률 vs 드롭 (k6 remote-write)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 9 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(k6_http_reqs_total[15s])", "legendFormat": "k6 요청/s" },
        { "refId": "B", "expr": "rate(k6_dropped_iterations_total[15s])", "legendFormat": "드롭/s (도착률 유지 실패)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "에러율 (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_request_duration_seconds_count{route=\"/api/v1/events/:eventId/reservations\",status=~\"5..\"}[15s])) or vector(0)) / clamp_min(sum(rate(http_request_duration_seconds_count{route=\"/api/v1/events/:eventId/reservations\"}[15s])), 0.001)",
          "legendFormat": "5xx 비율"
        }
      ]
    },
    {
      "type": "row",
      "title": "DB 커넥션 풀 — 요청이 어디서 줄 서는가",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },
    {
      "type": "timeseries",
      "title": "풀 상태 (waiting > 0 = 요청이 DB 가 아니라 풀 앞에서 대기)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "db_pool_connections", "legendFormat": "{{state}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "커넥션 획득 대기 p95 / p99 vs 트랜잭션 소요 p99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(db_pool_acquire_wait_seconds_bucket[15s])))",
          "legendFormat": "획득대기 p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(db_pool_acquire_wait_seconds_bucket[15s])))",
          "legendFormat": "획득대기 p99"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(db_transaction_duration_seconds_bucket[15s])))",
          "legendFormat": "트랜잭션 p99 (=커넥션 점유시간)"
        }
      ]
    },
    {
      "type": "row",
      "title": "자원 — 무엇이 먼저 포화되는가",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 }
    },
    {
      "type": "timeseries",
      "title": "앱 프로세스 CPU (1.0 = 코어 1개 완전 사용)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "max": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.85 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "rate(process_cpu_seconds_total{job=\"app\"}[15s])", "legendFormat": "app CPU 코어" }
      ]
    },
    {
      "type": "timeseries",
      "title": "이벤트루프 지연 p99 (단일 스레드 포화 신호)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "nodejs_eventloop_lag_p99_seconds", "legendFormat": "eventloop lag p99" },
        { "refId": "B", "expr": "nodejs_eventloop_lag_mean_seconds", "legendFormat": "eventloop lag mean" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Postgres 백엔드 커넥션 (state 별)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 26 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (pg_stat_activity_count{datname=\"lts\"})",
          "legendFormat": "{{state}}"
        }
      ]
    }
  ]
}
